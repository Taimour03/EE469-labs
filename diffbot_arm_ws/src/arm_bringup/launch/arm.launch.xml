<launch>
  <let name="urdf_path"
       value="$(find-pkg-share arm_description)/urdf/arm.xacro" />
  <let name="rviz_config_path"
       value="$(find-pkg-share arm_description)/rviz/arm_config.rviz" />
  <let name="robot_description"
       value="$(command 'xacro $(var urdf_path)')" />

  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(var robot_description)" />
  </node>

  <node pkg="controller_manager" exec="ros2_control_node">
    <param from="$(find-pkg-share arm_bringup)/config/arm_controllers.yaml" />
  </node>

  <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster" />

  <node pkg="controller_manager" exec="spawner" args="arm_controller" />

  <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)" />
</launch>
